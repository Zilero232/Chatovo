# Chatovo — Caddy config (runs on the VPS).
#
# chatovo.ru and app.chatovo.ru serve ONE static export; Caddy decides which
# pages each host exposes, so there is no second build.
#
# Needs DNS A-records for chatovo.ru, www, app, api and livekit pointing here,
# plus ports 80 and 443 open. TLS certificates are issued automatically.

(static_client) {
	root * /srv/www

	@assets path /_next/static/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	encode gzip
}

(static_routing) {
	try_files {path} {path}.html {path}/index.html /404.html
	file_server
}

www.chatovo.ru {
	redir https://chatovo.ru{uri} permanent
}

livekit.chatovo.ru {
	# LiveKit runs with network_mode: host, so from this bridge-networked
	# container it is reachable via host-gateway (see docker-compose.yml).
	#
	# The WSS signalling connection is exempt from CORS, but the client also
	# fetches /rtc/v1/validate, which is not. Allow-Origin must carry a single
	# value, so the request Origin is matched and echoed back.

	@cors_app header Origin https://app.chatovo.ru
	@cors_tauri header Origin tauri://localhost
	@cors_tauri_win header Origin http://tauri.localhost

	header @cors_app Access-Control-Allow-Origin "https://app.chatovo.ru"
	header @cors_tauri Access-Control-Allow-Origin "tauri://localhost"
	header @cors_tauri_win Access-Control-Allow-Origin "http://tauri.localhost"

	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Max-Age "3600"
		respond 204
	}

	reverse_proxy host.docker.internal:7880 {
		# LiveKit emits its own `Access-Control-Allow-Origin: *`; left in place
		# the browser sees the header twice and drops the user from the room.
		header_down -Access-Control-Allow-Origin
	}
}

api.chatovo.ru {
	reverse_proxy server:4000
}

app.chatovo.ru {
	import static_client

	# Nothing on the app host belongs in an index; the public site owns SEO.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Disallow: /
`
	}

	# The lobby is this host's front page, which is why the app has no /lobby URL.
	handle / {
		rewrite * /lobby.html
		file_server
	}

	handle {
		import static_routing
	}
}

chatovo.ru {
	import static_client
	import static_routing
}
