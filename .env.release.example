# Credentials for `bun deploy:web` and `bun release`.
# Copy to .env.release and fill in. Never commit the filled version.

# GitHub personal access token with `repo` + `write:packages`.
GITHUB_TOKEN=

# GHCR namespace the images are pushed to (your GitHub username or org).
GHCR_OWNER=

# Baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=https://api.chatovo.ru
NEXT_PUBLIC_LIVEKIT_URL=

# VPS the web + server containers run on.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22
DEPLOY_PATH=/opt/chatovo
DEPLOY_SSH_PASSWORD=

# Android release signing. ANDROID_KEY_BASE64 is the keystore, base64-encoded.
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
ANDROID_KEY_BASE64=
ANDROID_HOME=

# Password for ~/.tauri/chatovo.key — leave empty if the key has none.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
