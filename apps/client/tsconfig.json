{
  "extends": "@chatovo/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "messages.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "entities/**/*.ts",
    "entities/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "views/**/*.ts",
    "views/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "widgets/**/*.ts",
    "widgets/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
