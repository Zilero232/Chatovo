{
  "name": "@chatovo/server",
  "version": "0.0.0",
  "private": true,
  "description": "Chatovo API — NestJS on Bun with Prisma, better-auth and LiveKit.",
  "homepage": "https://chatovo.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Chatovo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Chatovo.git",
    "directory": "apps/server"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Alexandr Artemev",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:studio": "prisma studio",
    "predev": "fkill :4000 --force --silent",
    "dev": "bun --hot --cwd ../.. --env-file .env apps/server/src/main.ts",
    "postinstall": "prisma generate",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chatovo/schemas": "workspace:*",
    "@grammyjs/parse-mode": "^2.3.0",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/platform-ws": "11.1.29",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.29",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/render": "^2.1.0",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "catalog:",
    "cache-manager": "7.2.9",
    "date-fns": "catalog:",
    "express": "5.2.1",
    "firebase-admin": "^14.3.0",
    "grammy": "^1.46.0",
    "helmet": "8.3.0",
    "livekit-server-sdk": "^2.18.0",
    "mime-types": "^3.0.2",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "^6.9.3",
    "reflect-metadata": "0.2.2",
    "remeda": "catalog:",
    "rxjs": "7.8.2",
    "ts-pattern": "catalog:",
    "ws": "8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chatovo/tsconfig": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "typescript": "catalog:"
  }
}
