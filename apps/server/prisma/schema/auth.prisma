model User {
  id            String  @id
  name          String
  email         String  @unique
  friendTag     String  @unique
  emailVerified Boolean @default(false)
  image         String?

  role     String  @default("user")
  verified Boolean @default(false)

  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(3)
  blockedReason String?   @map("blocked_reason")
  blockedById   String?   @map("blocked_by_id")

  sessions Session[]
  accounts Account[]
  profile  Profile?
  rooms    Room[]
  messages Message[]

  dmRoomsA Room[]    @relation("DmUserA")
  dmRoomsB Room[]    @relation("DmUserB")
  
  pushDevices          PushDevice[]
  
  friendshipsRequested Friendship[] @relation("FriendshipRequester")
  friendshipsReceived  Friendship[] @relation("FriendshipAddressee")

  abuseReportsFiled   AbuseReport[] @relation("AbuseReporter")
  abuseReportsHandled AbuseReport[] @relation("AbuseHandler")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([blockedAt])
  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String    @default("local:credential")
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}
